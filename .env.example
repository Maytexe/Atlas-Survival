# Credenciais locais de desenvolvimento; altere antes de expor o banco.
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas-local-only
POSTGRES_PORT=5432

# URL assíncrona usada pelo backend.
DATABASE_URL=postgresql+asyncpg://atlas:atlas-local-only@127.0.0.1:5432/atlas

# Origens permitidas para chamadas da API, em formato JSON.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
